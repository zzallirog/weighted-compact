// thin file-mirror — exclude version control, envs, builds, heavy data/models
.git
.jj
.hg
.svn
// python / node envs (any suffix: .venv, .venv-airllm, venv-x ...)
.venv*
venv*
*-venv
__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
node_modules
// build artefacts
target
dist
build
*.egg-info
.DS_Store
*.log
.cache
.stfolder
// backups / timestamped dumps
*.bak
*-bak
*.old
*~
backup
backups
data.pre-*
// heavy data / models / vector stores / dbs
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
chroma
chromadb
.chroma
data
datasets
models
checkpoints
*.sqlite
*.sqlite3
*.db
// nested vendored upstream (re-clonable, not part of thin replica)
ruflo
