# Personal substrate — NEVER commit.
# Every weighted-compact install grows its own substrate under
# $WEIGHTED_COMPACT_DATA (default: $XDG_DATA_HOME/weighted-compact or
# ~/.local/share/weighted-compact/). Substrate is built from the user's own
# Claude Code sessions; it contains raw conversation text and must stay local.
#
# Defense in depth: explicit pattern rules plus a final catch-all on the
# substrate dir name, so even a stray `cp` into the checkout cannot leak.

# JSONL substrate (pairs, labels, annotations, queues, audits)
*.jsonl
*.jsonl.*

# Feature caches and trained classifier weights
*.npz
*.npz.*
*.model
*.pkl
*.pickle

# Anything under a `substrate/` or `data/` dir in the checkout
substrate/
data/
**/substrate/
**/data/

# Backups created by feature extractors / labelers (`.bak.YYYYMMDD-HHMMSS`)
*.bak.*

# Schema-extraction artifacts — schema-bank.yaml is built from the user's
# memory dir and contains personal infrastructure references. Reports
# carry full episode content. Both stay strictly under $XDG_DATA_HOME and
# must never enter the checkout. Example template is in examples/ and is OK.
schema-bank.yaml
schema-runs/
**/schema-bank.yaml
**/schema-runs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Filter-repo backups (if ever needed)
.git.bak.*/

# Claude Code session state — never publish
.claude/
.claude-work/

# Mooted research modules (β-schedule / CMA search / CV / COM-shift / replay /
# sandbox / ablation). Kept on disk for the maintainer's exploration but never
# shipped — the importance-mixture hypothesis they served came back null.
weighted_compact/beta_schedule.py
weighted_compact/beta_search.py
weighted_compact/cv_harness.py
weighted_compact/com_shift.py
weighted_compact/replay_eval.py
weighted_compact/sandbox_probe.py
weighted_compact/ablation_axes.py
tests/test_beta_schedule.py
tests/test_beta_search.py
tests/test_cv_harness.py
tests/test_sandbox_probe.py

# Syncthing internals + root-level research scripts (never shipped)
.stfolder/
.stignore
/ablation_axes.py
/sandbox_probe.py
